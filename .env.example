# Copy this file to .env and replace the placeholders. Never commit .env.
# The key is read only by the server; it is never sent to the browser.

# Google Gemini API key for live document extraction.
# Leave the placeholder to run without live extraction (sample mode still works).
GEMINI_API_KEY=your-gemini-api-key

# Gemini model used for extraction. See https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.6-flash
# Optional comma-separated models tried in order if the main model is overloaded or unavailable
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=90

# Prototype limits
MAX_UPLOAD_MB=5
MAX_FILES_PER_CLAIM=12
MAX_PDF_PAGES=10
EXTRACTION_WORKERS=3

# Private storage for the SQLite database and uploaded files (not web-served)
DATA_DIR=./data

# Set to true when serving over HTTPS so the session cookie is marked Secure
SECURE_COOKIES=false
